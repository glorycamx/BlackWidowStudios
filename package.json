{
  "name": "black-widow-client-portal",
  "version": "0.1.0",
  "description": "Black Widow Studios client portal: leads, revisions, AI support chat with team escalation, push notifications, upsells.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,gray \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "check": "tsc --noEmit && vite build",
    "preflight": "tsx scripts/preflight.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "vapid:generate": "web-push generate-vapid-keys",
    "build:demo": "vite build --config vite.demo.config.ts && node scripts/finish-demo.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glorycamx/BlackWidowStudios.git"
  },
  "bugs": {
    "url": "https://github.com/glorycamx/BlackWidowStudios/issues"
  },
  "homepage": "https://github.com/glorycamx/BlackWidowStudios#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
