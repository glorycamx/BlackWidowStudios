# Postgres (Replit provides this automatically)
DATABASE_URL=postgres://bw:bw@localhost:5432/blackwidow

# Long random string for signing login sessions
SESSION_SECRET=change-me

# Claude API key for the support chatbot. Without it, chat messages go straight to the team.
ANTHROPIC_API_KEY=

# Web Push (phone notifications). Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@blackwidow.studio

# Optional: email alerts to the team through Resend
RESEND_API_KEY=
TEAM_ALERT_EMAILS=admin@blackwidow.studio
EMAIL_FROM="Black Widow Studios <hello@blackwidow.studio>"

# First-run team accounts, "Name:email" comma separated. Passwords are printed once to the server log.
TEAM_SEED=Cam:admin@blackwidow.studio,Trae:trae@blackwidow.studio

# Set to 1 to create a demo client (demo@blackwidow.studio / demo1234) with sample data
SEED_DEMO=1

# Public URL of this app (used in notification and email links)
APP_URL=http://localhost:5173
