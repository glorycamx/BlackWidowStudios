# Z80.si — environment variables. Copy to .env.local and fill in.
# Nothing here is required to run the demo: every service falls back to the
# local mock implementation in lib/services when a value is missing.

# Public site URL (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=https://z80.si

# --- AI provider (server-only; never prefix with NEXT_PUBLIC_) ---
# Selects the planner/chat provider in lib/ai/provider.ts. "mock" by default.
Z80_AI_PROVIDER=mock
Z80_AI_API_KEY=
Z80_AI_MODEL=

# --- Auth provider (see lib/auth) ---
# "mock" until Clerk / Auth0 / Supabase is wired in.
Z80_AUTH_PROVIDER=mock
