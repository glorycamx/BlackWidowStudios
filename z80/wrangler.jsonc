{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "z80",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Serve the site on the apex and www. The z80.si zone must be on this Cloudflare account.
  "routes": [
    { "pattern": "z80.si", "custom_domain": true },
    { "pattern": "www.z80.si", "custom_domain": true }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://z80.si"
  },
  "observability": { "enabled": true }
}
